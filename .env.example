# =====================================================================
# SIM Kelompok Tani Ngudi Makmur — contoh variabel lingkungan
# Salin menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Berkas ini (.env.example) di-commit TANPA nilai rahasia (Security.md §Rahasia).
# =====================================================================

# --- Aplikasi ---------------------------------------------------------
# Alamat aplikasi, dipakai untuk tautan login/undangan Supabase Auth.
# Lokal: http://localhost:3000. Di Vercel boleh dikosongkan: aplikasi otomatis memakai domain produksi Vercel
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL). Isi hanya bila memakai domain sendiri.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (akun kelurahan) ----------------------------------------
# Dashboard Supabase → Project Settings → Data API / API Keys.
# URL proyek, mis. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publik (sb_publishable_...). Kunci "anon" lama juga bisa dipakai di sini.
# Aman di browser karena semua tabel dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci rahasia (sb_secret_...; pengganti service_role). HANYA server, tanpa prefiks NEXT_PUBLIC_.
# Dipakai sebatas tugas admin teknis (membuat akun) setelah requireRole(["admin_teknis"]).
SUPABASE_SECRET_KEY=

# --- Supabase CLI (opsional, untuk migrasi & generator tipe) ----------
# Reference ID proyek = bagian "abcdefghijklmno" pada URL di atas.
SUPABASE_PROJECT_REF=
# Kata sandi database (dibuat saat membuat proyek). Hanya dipakai `supabase link` / `supabase db push`.
SUPABASE_DB_PASSWORD=

# --- Vercel & GitHub --------------------------------------------------
# Tidak perlu variabel di sini. Vercel menyambung ke repositori GitHub lewat dashboard,
# lalu variabel Supabase di atas diisi di Vercel → Project → Settings → Environment Variables.
